<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ProjectDescribedActivity">

    <Button
        android:id="@+id/btn_project_described_back"
        android:layout_width="65dp"
        android:layout_height="50dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:background="@mipmap/temp_back_icon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/imgProjectDescribed"
        android:layout_width="293dp"
        android:layout_height="292dp"
        android:layout_marginTop="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view_p_d_a"
        tools:srcCompat="@tools:sample/avatars" />



    <TextView
        android:id="@+id/txtProjectDescribedCategory"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toEndOf="@+id/imgProjectDescribed"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="@+id/imgProjectDescribed"
        app:layout_constraintTop_toBottomOf="@+id/imgProjectDescribed" />

    <TextView
        android:id="@+id/txtProjectDescribedDescription"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_edittext_rounded"
        android:paddingLeft="8dp"
        android:paddingEnd="2dp"
        android:paddingRight="8dp"
        android:paddingBottom="2dp"
       android:gravity="center"
        app:autoSizeTextType="uniform"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtProjectDescribedCategory" />

    <Button
        android:id="@+id/btn_project_described_p"
        android:background="@drawable/bg_button_rounded"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="44dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/txt_project_described_need"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/project_described_need"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.51"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtProjectDescribedDescription" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_project_described"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingTop="8dp"
        app:layout_constraintBottom_toTopOf="@+id/btn_project_described_p"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txt_project_described_need" />

    <View
        android:id="@+id/view_p_d_a"
        android:layout_width="0dp"
        android:layout_height="82dp"
        android:background="@color/bg_profile_image"
        app:layout_constraintBottom_toBottomOf="@+id/btn_project_described_back"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/txtProjectDescribedName"
        android:layout_width="wrap_content"
        android:layout_height="23dp"
        app:layout_constraintBottom_toBottomOf="@+id/view_p_d_a"
        app:layout_constraintEnd_toEndOf="@+id/view_p_d_a"
        app:layout_constraintStart_toStartOf="@+id/view_p_d_a"
        app:layout_constraintTop_toTopOf="@+id/view_p_d_a" />
</androidx.constraintlayout.widget.ConstraintLayout>