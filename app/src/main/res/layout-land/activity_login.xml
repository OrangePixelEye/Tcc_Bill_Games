<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_color"
    tools:context=".LoginActivity">

    <Button
        android:id="@+id/btn_register"
        android:layout_width="301dp"
        android:layout_height="45dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="73dp"
        android:layout_marginTop="50dp"
        android:layout_marginEnd="37dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_button_rounded"
        android:text="@string/login_button" />

    <EditText
        android:id="@+id/edit_password_register"
        android:layout_width="389dp"
        android:layout_height="52dp"
        android:layout_below="@+id/edit_email_register"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true"
        android:layout_marginStart="7dp"
        android:layout_marginTop="30dp"
        android:layout_marginEnd="7dp"
        android:background="@drawable/bg_edittext_rounded"
        android:ems="10"
        android:hint="@string/login_password"
        android:importantForAutofill="no"
        android:inputType="textPassword"
        android:paddingLeft="8dp" />

    <EditText
        android:id="@+id/edit_email_register"
        android:layout_width="389dp"
        android:layout_height="52dp"
        android:layout_below="@+id/imageView2"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true"
        android:layout_marginStart="7dp"
        android:layout_marginTop="30dp"
        android:layout_marginEnd="7dp"
        android:autofillHints=""
        android:background="@drawable/bg_edittext_rounded"
        android:ems="10"
        android:hint="@string/login_email"
        android:inputType="textEmailAddress"
        android:paddingLeft="8dp" />

    <TextView
        android:id="@+id/textview_register_login"
        android:layout_width="148dp"
        android:layout_height="wrap_content"
        android:layout_below="@+id/edit_password_register"
        android:layout_alignEnd="@+id/edit_password_register"
        android:layout_alignParentStart="true"
        android:layout_marginStart="139dp"
        android:layout_marginTop="30dp"
        android:layout_marginEnd="99dp"
        android:gravity="center"
        android:text="@string/login_create_account" />

    <ImageView
        android:id="@+id/imageView2"
        android:layout_width="90dp"
        android:layout_height="86dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginStart="324dp"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="316dp"
        tools:srcCompat="@tools:sample/avatars" />

</RelativeLayout>